{
  "name": "lo-carb-website",
  "version": "1.0.0",
  "private": true,
  "description": "LO-CARB website (static HTML) + design tokens + Storybook component library",
  "scripts": {
    "build": "npm run build-storybook && node scripts/assemble.mjs",
    "storybook": "storybook dev -p 6006 -c storybook-config",
    "build-storybook": "storybook build -c storybook-config -o storybook-static && node scripts/copy-home.mjs",
    "website": "npx --yes serve website -l 3000"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "8.6.19",
    "@storybook/html": "8.6.19",
    "@storybook/html-vite": "8.6.19",
    "storybook": "8.6.19",
    "vite": "6.4.6"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "allowScripts": {
    "esbuild": true
  }
}
